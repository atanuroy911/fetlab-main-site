# Create a free project at https://www.sanity.io/manage, then fill these in.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Canonical origin of the deployed site (used for metadata, sitemap.xml, robots.txt).
NEXT_PUBLIC_SITE_URL=https://fetlab.org

# Contact form (Resend). Without these the contact page falls back to a mailto link.
# Get a key at https://resend.com and verify your sending domain.
RESEND_API_KEY=re_xxxxxxxx
CONTACT_FROM_EMAIL=website@fetlab.org
# Optional: overrides the contact email set in Sanity site settings.
CONTACT_TO_EMAIL=
